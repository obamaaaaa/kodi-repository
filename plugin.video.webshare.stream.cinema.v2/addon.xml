<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon 
    id="plugin.video.webshare.stream.cinema.v2" 
    name="Webshare Stream Cinema V2" 
    version="2.1.6" 
    provider-name="dlazebnikostka">

    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" />
    </requires>

    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>

    <extension point="xbmc.service" library="status_checker.py"/>

    <extension point="xbmc.addon.metadata">
        <summary>Webshare Stream Cinema</summary>
        <description>Přehrávej filmy a seriály přes Webshare pomocí TheMovieDb.</description>
        <platform>all</platform>
        <language>cs</language>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>

</addon>